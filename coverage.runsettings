<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- EF migrations and model snapshots are generated code. -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <!-- The sibling Access Control source is referenced by flow tests; report this repository's code. -->
          <Exclude>[AccessControl.*]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
